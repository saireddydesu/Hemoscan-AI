# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FLASK_BACKEND_URL: Base URL of the deployed Render Python Flask ML server.
FLASK_BACKEND_URL="https://hemoscan-backend.onrender.com"

# VITE_FLASK_API_URL: Client-side Render Flask API base URL.
VITE_FLASK_API_URL="https://hemoscan-backend.onrender.com"

# MODEL_PATH & CLASS_LABELS: Optional Python Flask model configuration for app.py
MODEL_PATH=""
CLASS_LABELS="A+,A-,AB+,AB-,B+,B-,O+,O-"

# Supabase Auth & Database (Optional — enables cloud authentication & persistent user history)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
